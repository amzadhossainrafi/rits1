# ---- REQUIRED ----
DOMAIN=app.yourdomain.com
POSTGRES_PASSWORD=change-this-long-random-password
SECRET_KEY=paste-output-of: openssl rand -hex 32
SUPERADMIN_EMAIL=you@yourdomain.com
SUPERADMIN_PASSWORD=choose-a-strong-password-12+chars

# ---- OPTIONAL ----
TRIAL_DAYS=14
ALLOW_SIGNUP=1
PAY_INSTRUCTIONS=Send the amount by bKash/Nagad (Personal) to 01XXXXXXXXX, then submit the transaction ID below.
# Card payments (Stripe) - leave empty to use bKash/Nagad/bank only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Email for password-reset links - leave empty and reset passwords from the Admin screen instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RITS One <no-reply@yourdomain.com>
